# Copy to .env and fill in what you use. Restart with `docker compose up -d` after changes.

# Postgres (only used inside docker compose)
POSTGRES_DB=tracker
POSTGRES_USER=tracker
POSTGRES_PASSWORD=change-me

# Web UI port on your PC -> http://localhost:8080
TRACKER_PORT=8080

# ---- AI providers for hints & reviews (pick the active one in Settings) ----
# Anthropic API key (console.anthropic.com)
ANTHROPIC_API_KEY=
# DeepSeek API key (platform.deepseek.com)
DEEPSEEK_API_KEY=
# Claude Code: run `claude setup-token` on your PC and paste the token here (uses your Claude subscription)
CLAUDE_CODE_OAUTH_TOKEN=
